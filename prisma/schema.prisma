// Skema database portfolio.
// - Konten (Profile, SkillGroup, Project): diedit lewat /admin, dibaca halaman utama (di-cache, tag "content").
// - ChatSession / ChatMessage: log percakapan terminal AI + dasar rate limit.
// - PageEvent: analytics anonim (kunjungan & hop yang dibuka).
// Privasi: IP pengunjung nggak pernah disimpan, cuma hash-nya (ipHash = sha256(IP_SALT + ip)).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Satu baris aja (id = 1).
model Profile {
  id            Int      @id @default(1)
  name          String
  domain        String
  role          String
  location      String
  tagline       String
  /// paragraf bio, urut
  bio           String[]
  /// cerita perjalanan (hop Keep-Alive), paragraf urut
  story         String[] @default([])
  /// [{ label, value }]
  facts         Json
  /// [{ label, href }]
  socials       Json
  email         String
  timezone      String
  timezoneLabel String
  updatedAt     DateTime @updatedAt
}

model SkillGroup {
  id    Int      @id @default(autoincrement())
  name  String
  items String[]
  order Int      @default(0)
}

model Project {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  year        String
  role        String
  description String
  stack       String[]
  liveUrl     String?
  repoUrl     String?
  thumbnail   String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(cuid())
  ipHash    String
  userAgent String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]

  @@index([createdAt])
}

model ChatMessage {
  id           Int         @id @default(autoincrement())
  sessionId    String
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// "user" | "assistant"
  role         String
  content      String
  ipHash       String
  /// diisi buat pesan assistant
  model        String?
  inputTokens  Int?
  outputTokens Int?
  /// "end_turn" | "refusal" | "error" | ...
  stopReason   String?
  createdAt    DateTime    @default(now())

  @@index([ipHash, createdAt])
  @@index([sessionId, createdAt])
  @@index([role, createdAt])
}

model PageEvent {
  id        Int      @id @default(autoincrement())
  /// id acak per tab (sessionStorage), bukan identitas orang
  visitId   String
  /// "view" | "hop"
  type      String
  hop       String?
  path      String?
  /// cuma hostname referrer
  referrer  String?
  /// "desktop" | "mobile"
  device    String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([visitId])
}

// ---------- Better Auth (login admin via Google) ----------
// Bentuk tabel ngikutin core schema better-auth 1.7 (user, session, account, verification).
// Kalau upgrade better-auth, cek ulang dengan `npx auth@latest check schema`.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// "Easter egg" buat AI terminal: tokoh publik / temen yang dikenali AI kalau namanya disebut.
/// Diisi admin (/admin/easter-eggs), dibaca system prompt chat. Bukan data publik di halaman.
model Reference {
  id        Int      @id @default(autoincrement())
  /// "public" (tokoh publik) | "friend" (temen) | "other"
  kind      String   @default("public")
  /// nama + panggilan, mis. ["Prabowo", "wowo"]
  names     String[]
  /// fakta / cara jawab yang dimau pemilik situs
  note      String
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
