# Salin jadi .env lalu isi. File .env TIDAK di-commit.

# --- Database (PostgreSQL) ---
# Lokal: postgresql://USER:PASSWORD@localhost:5432/portfolio
# Production: connection string dari Neon / Supabase / Vercel Postgres.
# Pakai sslmode=verify-full (bukan require) biar nggak ada SECURITY WARNING dari pg.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio"

# --- Claude (Anthropic API) ---
# Bikin key di https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=""
# Opsional. Default: claude-haiku-5-5 (murah & cepat, cukup buat tanya-jawab portfolio).
# Kalau diganti, cek tarifnya di PRICES (src/lib/chat.ts) biar estimasi biaya admin bener.
# CHAT_MODEL="claude-haiku-5-5"

# --- Rate limit chat (opsional, ini default-nya) ---
# CHAT_LIMIT_PER_10MIN=10    # per pengunjung (IP di-hash)
# CHAT_LIMIT_PER_DAY=40      # per pengunjung
# CHAT_LIMIT_GLOBAL_DAY=500  # semua pengunjung digabung, rem biaya API
# CHAT_LIMIT_PER_SESSION=20  # pertanyaan per sesi chat

# --- Admin login: Neon Auth (Better Auth managed by Neon), via Google ---
# Neon Console -> project -> Auth: aktifin, nyalain provider Google, salin "Auth URL".
# Tambahin domain production lo di Auth > Configuration > Domains.
NEON_AUTH_BASE_URL=""
# Rahasia tanda tangan cookie sesi. Minimal 32 karakter acak:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
# Email Google yang boleh masuk /admin, pisahin koma. Akun lain bisa login tapi ditolak.
ADMIN_EMAILS="kamu@gmail.com"

# --- Thumbnail project: Neon Object Storage (S3-compatible) ---
# Bikin bucket dengan akses public_read (nggak bisa diubah nanti), lalu credential storage.
# `neon deploy` / Neon Console ngasih 4 nilai AWS_* ini.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION="us-east-2"
STORAGE_BUCKET="portfolio-public"

# --- Privasi analytics ---
# Garam buat hash IP pengunjung (IP asli nggak pernah disimpan). String acak panjang.
IP_SALT=""
